# Environment variables for Baligh-1.5B v0

# WandB for experiment tracking
WANDB_API_KEY=your_wandb_api_key
WANDB_PROJECT=baligh-1.5b
WANDB_ENTITY=your_wandb_entity

# Hugging Face Hub
HF_TOKEN=your_hf_token

# CUDA
CUDA_VISIBLE_DEVICES=0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Training
SEED=42
DETERMINISTIC=true
