# Environment variables for Baligh-1.7B v0

# WandB for experiment tracking.
# If no key is set, training reports to tensorboard only (never blocks).
WANDB_API_KEY=your_wandb_api_key
WANDB_PROJECT=Baligh-1.7B
WANDB_ENTITY=your_wandb_entity

# Hugging Face Hub
HF_TOKEN=your_hf_token

# Modal web-endpoint API key (server side; clients send it as x-api-key)
# Create the Modal secret with: modal secret create baligh-api-key BALIGH_API_KEY=<value>
BALIGH_API_KEY=

# CUDA
CUDA_VISIBLE_DEVICES=0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Training
SEED=42
DETERMINISTIC=true
# fp16 works on all target GPUs; bf16 requires sm_80+ (auto-checked at load)
MIXED_PRECISION=fp16
